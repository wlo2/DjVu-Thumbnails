<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The host app is deliberately unsandboxed: its only job is to host the
	     extension and to preview arbitrary files the user drops on it. The
	     extension itself is sandboxed. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
